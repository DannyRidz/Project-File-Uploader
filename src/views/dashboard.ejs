<%- include("partials/header", { title: "Dashboard" }) %>

<main class="page">
  <header class="page-heading">
    <div>
      <p class="eyebrow">Your storage</p>
      <h1>Your files</h1>
      <p>Signed in as <%= currentUser.email %></p>
    </div>
  </header>

  <section class="card">
    <h2>Create a folder</h2>

    <% if (folderErrors.length > 0) { %>
      <section class="error-box" aria-labelledby="folder-error-heading">
        <h3 id="folder-error-heading">Please fix the following:</h3>

        <ul>
          <% folderErrors.forEach((error) => { %>
            <li><%= error.msg %></li>
          <% }); %>
        </ul>
      </section>
    <% } %>

    <form class="folder-form" action="/folders" method="post">
      <div class="field">
        <label for="name">Folder name</label>
        <input
          id="name"
          name="name"
          type="text"
          value="<%= folderValues.name %>"
          maxlength="80"
          required
        >
      </div>

      <button class="button" type="submit">Create folder</button>
    </form>
  </section>

  <section class="card storage-section">
  <h2>Upload a file</h2>
  <p>Allowed types: JPEG, PNG, PDF, and plain text. Maximum size: 5 MB.</p>

  <form
    class="stack"
    action="/files"
    method="post"
    enctype="multipart/form-data"
  >
    <div class="field">
      <label for="file">Choose file</label>
      <input
        id="file"
        name="file"
        type="file"
        accept=".jpg,.jpeg,.png,.pdf,.txt"
        required
      >
    </div>

    <div class="field">
      <label for="folderId">Folder</label>
      <select id="folderId" name="folderId">
        <option value="">Root</option>

        <% folders.forEach((folder) => { %>
          <option value="<%= folder.id %>"><%= folder.name %></option>
        <% }); %>
      </select>
    </div>

    <button class="button" type="submit">Upload file</button>
  </form>
</section>

  <section class="storage-section" aria-labelledby="folders-heading">
    <h2 id="folders-heading">Folders</h2>

    <% if (folders.length === 0) { %>
      <div class="empty-state">
        <h3>No folders yet</h3>
        <p>Create your first folder using the form above.</p>
      </div>
    <% } else { %>
      <div class="folder-grid">
        <% folders.forEach((folder) => { %>
          <article class="folder-card">
            <div>
              <p class="folder-icon" aria-hidden="true">📁</p>
              <h3><%= folder.name %></h3>
            </div>

            <div class="folder-actions">
              <a href="/folders/<%= folder.id %>/edit">Rename</a>

              <form action="/folders/<%= folder.id %>/delete" method="post">
                <button class="danger-button" type="submit">
                  Delete
                </button>
              </form>
            </div>
          </article>
        <% }); %>
      </div>
    <% } %>
  </section>

<section class="storage-section" aria-labelledby="files-heading">
  <h2 id="files-heading">Files</h2>

  <% if (files.length === 0) { %>
    <div class="empty-state">
      <h3>No files yet</h3>
      <p>Upload your first file using the form above.</p>
    </div>
  <% } else { %>
    <div class="file-list">
      <% files.forEach((file) => { %>
        <article class="file-row">
          <div>
            <h3><%= file.originalName %></h3>
            <p>
              <%= file.folder ? file.folder.name : "Root" %>
              ·
              <%= Math.ceil(file.size / 1024) %> KB
            </p>
          </div>

          <time datetime="<%= file.uploadedAt.toISOString() %>">
            <%= file.uploadedAt.toLocaleString() %>
          </time>
        </article>
      <% }); %>
    </div>
  <% } %>
</section>

</main>

<%- include("partials/footer") %>